# =============================================================================
# config/.env.example  -  Linux toolkit settings (POSIX sh syntax)
# =============================================================================
# Example values for the "Great Cretaceous" practice pod (lab: 192.168.100.0/24).
#
# HOW TO USE
#   cp config/.env.example config/ccdc.env     # ccdc.env is gitignored
#   vi config/ccdc.env                          # set competition subnet / IPs
#   sh linux/launch.sh --config config/ccdc.env
#
# WARNING: this file is *sourced* (executed) by the scripts with ". FILE".
#          Only use a copy you wrote yourself. NEVER put passwords in here.
# =============================================================================

# --- Pod-wide -----------------------------------------------------------------
SUBNET="192.168.100.0/24"
# Sources allowed to reach SSH (space separated CIDRs). Your current SSH
# client IP is ALWAYS allowed in addition, so you never lock yourself out.
ADMIN_SOURCES="192.168.100.0/24"

# Central logging (tarpit / Graylog)
GRAYLOG_IP="192.168.100.170"
GRAYLOG_SYSLOG_PORT="514"

# --- This box -----------------------------------------------------------------
# Ports the scoring engine checks on THIS box. firewall.sh only allows these
# (plus SSH). These are guesses for each Great Cretaceous host - confirm them!
#   hatchery : "22 3306 9000 9001"
#   hellcreek: "22 8080 8443"
#   badlands : "22 80 443"
#   tarpit   : "22 9000 5044"     (UDP: "514 12201")
#   laboratory: "22"
ALLOW_TCP_PORTS="22"
ALLOW_UDP_PORTS=""

# Accounts the scoring engine uses. Password rotation will SKIP these.
# You need an approved Password Change Request before changing them.
SCORED_USERS=""

# Web roots to back up / scan for web shells (space separated)
WEB_ROOTS="/var/www /usr/share/nginx/html /srv/www"

# --- Host inventory (for network/scan-pod.sh and docs) ------------------------
HOST_PANGEA="192.168.100.2"
HOST_TREX="192.168.100.12"
HOST_FOSSIL="192.168.100.20"
HOST_FERNBANK="192.168.100.37"
HOST_LABORATORY=""          # not in practice packet - fill in
HOST_HATCHERY="192.168.100.76"
HOST_HELLCREEK="192.168.100.103"
HOST_BADLANDS=""            # not in practice packet - fill in
HOST_TARPIT="192.168.100.170"
